            "id",
            "command"
          ],
          "title": "Check",
          "type": "object"
        },
        "Metric": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 40,
              "minLength": 1,
              "title": "Id",
              "type": "string"
            },
            "name": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "kind": {
              "enum": [
                "behavior",
