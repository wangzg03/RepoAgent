  {
    "name": "read_file",
    "description": "Read a bounded UTF-8 source window and its SHA256. Follow next_offset/next_column to continue. Content contains exact text without added line numbers.",
    "parameters": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Workspace-relative POSIX file path, e.g. src/module.py."
        },
        "offset": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "file_path"
      ],
      "additionalProperties": false
    },
    "read_only": true,
    "concurrency_safe": true,
    "category": "filesystem",
    "output": "text; structured JSON where documented",
