  {
    "name": "scratchpad",
    "description": "Persist hypotheses and next experiments. write REQUIRES key and value, e.g. action=write,key=hypothesis,value=your note. merge requires an object; without key it updates top-level notes. read may omit key to recover all notes. delete requires key.",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "merge",
            "delete"
          ]
        },
        "key": {
          "type": "string",
          "maxLength": 120,
          "description": "Required and nonempty for write/delete. Optional for read/merge."
        },
        "value": {
          "description": "For merge, an object such as {hypothesis:...,next_experiment:...}; use write for plain text."
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 100,
          "maximum": 4000
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "read_only": false,
    "concurrency_safe": false,
    "category": "memory",
    "output": "text; structured JSON where documented",
    "execution": {
      "read_only": false,
      "concurrency_safe": false,
      "journaled": true,
      "cancellation": "task_deadline",
      "output": "bounded; captured receipts are recoverable; transport caps may truncate"
    }
  },
  {
    "name": "todo_write",
    "description": "Record complete intent/requirements, constraints, a bounded plan and repair reflection in one call. Check coverage against real current-workspace receipts. Done is not acceptance.",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "check"
          ]
        },
        "intent": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "implement",
                "fix",
                "refactor",
                "test",
                "explain",
                "locate",
                "review"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "behavior": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  }
                },
                "required": [
                  "id",
                  "behavior"
                ],
                "additionalProperties": false
              }
            },
            "constraints": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "maxLength": 300
              }
            }
          },
          "required": [
            "kind",
            "summary",
            "requirements"
          ],
          "additionalProperties": false
        },
        "reflection": {
          "type": "object",
          "properties": {
            "failed_approach": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "hypothesis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "next_action": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "required": [
            "failed_approach",
            "hypothesis",
            "next_action"
          ],
          "additionalProperties": false
        },
        "request_offset": {
          "type": "integer",
          "minimum": 0
        },
        "tasks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "in_progress",
                  "done",
                  "blocked"
                ]
              },
              "dependencies": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string"
                }
              },
              "owner": {
                "type": "string",
                "maxLength": 40
              },
              "requirements": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "evidence": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 100
                }
              }
            },
            "required": [
              "content",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "read_only": false,
    "concurrency_safe": false,
    "category": "orchestration",
    "output": "text; structured JSON where documented",
